<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Replace PLUGIN-NAME, the bundle id, and the <Host> to match your target app.
     Host codes: Premiere PPRO, After Effects AEFT, Photoshop PHXS, Illustrator ILST,
     InDesign IDSN, Audition AUDT, Animate FLPR. -->
<ExtensionManifest ExtensionBundleId="com.yourstudio.PLUGINID" ExtensionBundleName="PLUGIN-NAME" ExtensionBundleVersion="1.0.0" Version="7.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.yourstudio.PLUGINID.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.yourstudio.PLUGINID.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PLUGIN-NAME</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>380</Width></Size>
            <MinSize><Height>360</Height><Width>300</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>800</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
