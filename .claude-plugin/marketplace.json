        "./llllloc/2_Skills/Program skills/tool-blender",
        "./llllloc/2_Skills/Program skills/tool-capture-one",
        "./llllloc/2_Skills/Program skills/tool-cavalry",
        "./llllloc/2_Skills/Program skills/tool-comfyui",
        "./llllloc/2_Skills/Program skills/tool-davinci-resolve",
        "./llllloc/2_Skills/Program skills/tool-figjam",
        "./llllloc/2_Skills/Program skills/tool-figma",
        "./llllloc/2_Skills/Program skills/tool-filmcraft",
        "./llllloc/2_Skills/Program skills/tool-illustrator",
        "./llllloc/2_Skills/Program skills/tool-magnific",
        "./llllloc/2_Skills/Program skills/tool-motion-app",
        "./llllloc/2_Skills/Program skills/tool-plasticity",
        "./llllloc/2_Skills/Program skills/tool-premiere-pro",
        "./llllloc/2_Skills/Program skills/tool-rclone",
        "./llllloc/2_Skills/Program skills/tool-soundly",
        "./llllloc/2_Skills/Outside skills/using-agent-skills"
      ],
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "echo \"llllloc core rule 9 (hook, 29 Oct 2026): your first tool call for this message is a Skill call on llllloc:router. Then follow router STEP 4 for the Loaded and Time lines. His message arrived at $(date '+%H:%M:%S %Z, %d %b %Y'): use this as his message's sent time for the Time line.\""
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "startup",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" git-pull",
                "timeout": 20
              },
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" core-rule",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" after-compact",
                "timeout": 20
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" stop-check",
                "timeout": 20
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Bash|mcp__[0-9a-f]{8}-.*",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" delete-guard",
                "timeout": 20
              }
            ]
          },
          {
            "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" skills-guard",
                "timeout": 20
              }
            ]
          },
          {
            "matcher": "mcp__.*__(spaces_create_node|spaces_patch_node|images_generate|video_generate|partner_generate)",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" research-guard",
                "timeout": 20
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/llllloc_hooks.py\" chmod-command",
                "timeout": 20
              }
            ]
          },
          {
            "matcher": "Write|Edit|MultiEdit|mcp__.*",
            "hooks": [
              {
                "type": "command",
                "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/llllloc/0_Core rule/hooks/impeccable/impeccable_hook.py\"",
                "timeout": 90
              }
            ]
          }
        ]
      }
    }
  ]
}
